# =============================================================================
# Tostapp — Production Environment Variables
# Copy this file to .env and fill in your values before deploying.
# =============================================================================

# --- Database ---
# Strong random password for PostgreSQL. Generate one with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=change_me_strong_password

# --- Application ---
# Full URL of your app including scheme (no trailing slash).
APP_URL=https://yourdomain.com

# Domain only (without https://), used by Caddy for TLS provisioning.
APP_DOMAIN=yourdomain.com

# Secret key for signing JWTs. Generate one with:
#   openssl rand -hex 64
SECRET_KEY=change_me_long_random_secret

# --- Email (Resend) ---
# Get a free API key at https://resend.com (3,000 emails/month free tier).
# Leave empty to print emails to console (dev/test mode).
RESEND_API_KEY=

# Sender address shown to recipients. Must match a verified domain in Resend.
EMAIL_FROM=Tostapp <noreply@yourdomain.com>

# Set to "true" to require email verification before users can log in.
EMAIL_VERIFICATION_REQUIRED=false
