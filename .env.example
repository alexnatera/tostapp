# PostgreSQL
POSTGRES_PASSWORD=changeme

# JWT
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# CORS (comma-separated, add production domains here)
CORS_ORIGINS=http://localhost:5173

# Rate limiting (slowapi format: "X/minute" or "X/second")
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFAULT=60/minute

# Email (SMTP) — optional; leave empty for dev mode (prints to console)
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
